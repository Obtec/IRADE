  "icons": [
    { "src": "irade-icon-192.png", "type": "image/png", "sizes": "192x192", "purpose": "any" },
    { "src": "irade-icon-512.png", "type": "image/png", "sizes": "512x512", "purpose": "any maskable" }
  ]
}
