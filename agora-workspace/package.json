{
  "name": "agora-workspace",
  "displayName": "Agora Shared Workspace",
  "icon": "assets/irade-icon-128.png",
  "description": "Edit and share the canvas VM /workspace through Project Agora and Wall.",
  "publisher": "irade",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "files": [
    "dist/extension.cjs",
    "dist/extension.cjs.map",
    "assets/irade-icon-128.png",
    "package.nls.json",
    "README.md",
    "LICENSE.txt",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "vscode": "^1.100.0"
  },
  "browser": "./dist/extension.cjs",
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onFileSystem:agora",
    "onStartupFinished"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "walkthroughs": [
      {
        "id": "agoraWorkspaceWelcome",
        "title": "IRADE Shared Workspace",
        "description": "Sign in to Agora and collaborate on the files in your workspace.",
        "steps": [
          {
            "id": "open",
            "title": "Open a Shared Workspace",
            "description": "Choose an Agora canvas to edit its VM workspace together.\n[Open Shared Workspace](command:agora.openWorkspace)",
            "media": {
              "image": "assets/irade-icon-128.png",
              "altText": "IRADE"
            }
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "agora.signIn",
        "title": "Sign In",
        "category": "Agora"
      },
      {
        "command": "agora.openWorkspace",
        "title": "Open Shared Workspace",
        "category": "Agora"
      },
      {
        "command": "agora.setToken",
        "title": "Set Access Token",
        "category": "Agora"
      },
      {
        "command": "agora.copyWorkspaceLink",
        "title": "Copy Workspace Link",
        "category": "Agora"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc --noEmit",
    "test": "node test/run.mjs",
    "serve": "node scripts/serve.mjs",
    "serve:https": "node scripts/serve-https.mjs",
    "test:web": "node test/web.mjs",
    "test:studio": "node test/studio.mjs"
  },
  "dependencies": {
    "@automerge/automerge": "3.5.0",
    "dompurify": "3.4.17",
    "koa": "^3.3.0",
    "marked": "18.2.0",
    "monaco-editor": "0.52.2"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@vscode/test-web": "0.0.81",
    "esbuild": "0.28.1",
    "typescript": "5.9.3",
    "ws": "8.19.0"
  }
}
