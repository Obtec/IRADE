# Certificates are manually supplied; setup.py records an absolute path.
NGINX_TLS_CERT_DIR=
NGINX_HTTPS_PORT=8453
NGINX_BACKEND_IP=10.29.0.250
# Exact source IP of an optional outer proxy; default trusts loopback only.
NGINX_TRUSTED_PROXY_IP=127.0.0.1
FRONTEND_MODE=production

# Filled by setup.py; shared internal token must match BE.
CPP_INTERNAL_API_TOKEN=
BROKER_SECRET_KEY_BASE=
BROKER_CPP_TARGETS='{"8002":"wss://irade-cpp:8002"}'
BROKER_TLS_CERT_DIR=
BROKER_TLS_SERVER_NAME=irade-broker
BROKER_ALLOWED_ORIGINS=https://localhost:8453,https://127.0.0.1:8453

# Shared with Spring only; never passed to C++.
JWT_SECRET=
# Optional logical WS port -> registered C++ advertised hostname (serverHash).
BROKER_CPP_IDENTITIES=

# Wall creates an isolated service network; storage networks are separate.
IRADE_SERVICES_SUBNET=10.29.0.0/16
STORAGE_MSSQL_UPSTREAM=mssql:1433
STORAGE_ES_UPSTREAM=elasticsearch:9200
STORAGE_REDIS_PRIMARY_UPSTREAM=10.26.0.2:6379
STORAGE_REDIS_REPLICA_1_UPSTREAM=10.26.0.7:6379
STORAGE_REDIS_REPLICA_2_UPSTREAM=10.26.0.5:6379
STORAGE_SENTINEL_1_UPSTREAM=10.26.0.6:26379
STORAGE_SENTINEL_2_UPSTREAM=10.26.0.3:26379
STORAGE_SENTINEL_3_UPSTREAM=10.26.0.4:26379

# Fixed Redis-side address: never compete with RedisInsight or Redis nodes.
STORAGE_REDIS_BROKER_IP=10.26.0.21
