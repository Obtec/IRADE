AGENT_API_KEY=
AGENT_BASE_URL=https://api.exaone.ai/v1
AGENT_MODEL=k-exaone_v2.5
AGENT_SOCKET=/run/irade-agent/agent.sock
AGENT_MAX_STEPS=8
AGENT_MAX_TOKENS=8192
AGENT_REASONING_EFFORT=low
AGENT_TIMEOUT_SECONDS=210
AGENT_MAX_CONCURRENT=2
