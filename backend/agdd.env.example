# Copy to agdd.env and fill in. Used by docker-compose.agdd.yml (--env-file agdd.env).
AGDD_PG_PASSWORD=
AGDD_PG_REPLICATION_PASSWORD=
AGDD_S3_SECRET_KEY=
AGDD_TESTDB_PASSWORD=
AGDD_API_TOKEN=
AGDD_GATEWAY_TOKEN=
AGDD_INTERNAL_TOKEN=
# Upstream OpenAI-compatible provider used by the LLM Gateway
AGDD_UPSTREAM_BASE_URL=https://api.openai.com/v1
AGDD_UPSTREAM_API_KEY=
AGDD_MODEL_CHEAP=gpt-5-nano
AGDD_MODEL_MID=gpt-5-mini
AGDD_MODEL_ADVISOR=gpt-5
# reasoning_effort for cheap tasks (EXAONE accepts low|medium|high, not minimal)
AGDD_CHEAP_REASONING_EFFORT=low
# Optional: JSON {"model": [input, cached_input, output] USD per 1M tokens}
AGDD_MODEL_PRICES=
# Optional embedding model (falls back to deterministic hash embedding, dim 1536)
AGDD_EMBED_MODEL=
AGDD_S2_API_KEY=
# Optional docs/RFC search proxy returning JSON results, e.g. http://searxng:8080/search?q={q}&format=json
AGDD_DOCS_SEARCH_URL=
AGDD_INTERNAL_NAMES=irade,frelog,agora
# Repositories the workers operate on (one subdirectory per repo_key)
AGDD_WORKSPACE_DIR=./agdd-workspace
# runc | runsc (gVisor)
AGDD_WORKER_RUNTIME=runc
# host uid/gid that owns AGDD_WORKSPACE_DIR
AGDD_UID=1000
AGDD_GID=1000
AGDD_INSTALL_PLAYWRIGHT=1
# Local time zone for 10:00/16:00 HITL digests
AGDD_TZ=Asia/Seoul
